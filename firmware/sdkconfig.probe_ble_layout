# Test build only (docs/desktop-app-design.md section 12): variant E, SmartHub's memory layout with the BLE probe started last.
CONFIG_DESKHUB_PROBE_HEAP=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_DESKHUB_PROBE_BLE=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# Wi-Fi and lwIP buffers in PSRAM; plain allocations of 4 KB and more in PSRAM (release: 16 KB).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# LVGL's objects in PSRAM (components/probe/lvgl_psram.c).
CONFIG_LV_USE_CLIB_MALLOC=n
CONFIG_LV_USE_CUSTOM_MALLOC=y
# Optimise for size: about 6 KB less internal RAM by SmartHub's measure.
CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
