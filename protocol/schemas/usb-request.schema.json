{
  "$id": "urn:deskhub:usb:v1:request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "UTF-8 JSON Lines over native USB Serial/JTAG. Maximum 16384 bytes including newline. Config is not logged. No arbitrary shell or register operations.",
  "oneOf": [
    {
      "properties": {
        "op": {
          "const": "identify"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "status"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "set_time"
        },
        "time": {
          "properties": {
            "ntp_server": {
              "default": "pool.ntp.org",
              "description": "Optional provisioning setting: ASCII DNS hostname or IPv4 address, no URL/path/port. Supports LAN NTP without Internet. set_time does not change the persisted NTP server.",
              "maxLength": 253,
              "minLength": 1,
              "type": "string"
            },
            "utc": {
              "description": "2024–2099; calendar validity is checked by firmware; no fractional seconds.",
              "format": "date-time",
              "pattern": "^20(?:2[4-9]|[3-9][0-9])-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})Z$",
              "type": "string"
            }
          },
          "required": [
            "utc"
          ],
          "type": "object"
        }
      },
      "required": [
        "op",
        "time"
      ],
      "type": "object"
    },
    {
      "properties": {
        "config": {
          "properties": {
            "agent": {
              "properties": {
                "agent_id": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
                  "type": "string"
                },
                "ca_pem": {
                  "description": "Valid PEM CA certificate(s), maximum 8192 UTF-8 bytes; never a private key.",
                  "maxLength": 8192,
                  "type": "string"
                },
                "token": {
                  "maxLength": 256,
                  "minLength": 32,
                  "pattern": "^[!-~]+$",
                  "type": "string",
                  "writeOnly": true
                },
                "url": {
                  "description": "HTTPS origin only; hostname verification remains enabled; no userinfo, path, query or fragment.",
                  "maxLength": 256,
                  "pattern": "^https://",
                  "type": "string"
                }
              },
              "required": [
                "url",
                "agent_id",
                "token",
                "ca_pem"
              ],
              "type": "object"
            },
            "time": {
              "properties": {
                "ntp_server": {
                  "default": "pool.ntp.org",
                  "description": "Optional provisioning setting: ASCII DNS hostname or IPv4 address, no URL/path/port. Supports LAN NTP without Internet. set_time does not change the persisted NTP server.",
                  "maxLength": 253,
                  "minLength": 1,
                  "type": "string"
                },
                "utc": {
                  "description": "2024–2099; calendar validity is checked by firmware; no fractional seconds.",
                  "format": "date-time",
                  "pattern": "^20(?:2[4-9]|[3-9][0-9])-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})Z$",
                  "type": "string"
                }
              },
              "required": [
                "utc"
              ],
              "type": "object"
            },
            "updates": {
              "additionalProperties": false,
              "properties": {
                "public_key_pem": {
                  "description": "Optional independently trusted ECDSA P-256 SPKI public key, installed through USB. Private keys rejected. Omission preserves an existing update trust root.",
                  "maxLength": 2048,
                  "type": "string"
                }
              },
              "required": [
                "public_key_pem"
              ],
              "type": "object"
            },
            "wifi": {
              "properties": {
                "password": {
                  "description": "Empty for open network, otherwise 8–63 UTF-8 bytes; no NUL.",
                  "maxLength": 63,
                  "type": "string",
                  "writeOnly": true
                },
                "ssid": {
                  "description": "Maximum 32 UTF-8 bytes, not codepoints; no NUL.",
                  "maxLength": 32,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "ssid",
                "password"
              ],
              "type": "object"
            }
          },
          "required": [
            "wifi",
            "agent",
            "time"
          ],
          "type": "object"
        },
        "op": {
          "const": "provision"
        }
      },
      "required": [
        "op",
        "config"
      ],
      "type": "object"
    }
  ],
  "title": "DeskHub USB request"
}
