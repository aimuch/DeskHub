{
  "$defs": {
    "HostSnapshot": {
      "properties": {
        "host_id": {
          "title": "Host Id",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "online": {
          "title": "Online",
          "type": "boolean"
        }
      },
      "required": [
        "host_id",
        "online",
        "metrics"
      ],
      "title": "HostSnapshot",
      "type": "object"
    },
    "Metric": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "quality": {
          "enum": [
            "valid",
            "stale",
            "unavailable",
            "unsupported",
            "invalid"
          ],
          "title": "Quality",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "ttl_ms": {
          "title": "Ttl Ms",
          "type": "integer"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "key",
        "label",
        "value",
        "unit",
        "source",
        "observed_at",
        "ttl_ms",
        "quality"
      ],
      "title": "Metric",
      "type": "object"
    }
  },
  "$id": "urn:deskhub:protocol:v1:hosts",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "hosts": {
      "items": {
        "$ref": "#/$defs/HostSnapshot"
      },
      "title": "Hosts",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "hosts"
  ],
  "title": "HostsResponse",
  "type": "object"
}
