{
  "$id": "urn:deskhub:usb:v1:response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "description": "provision result must include saved:true only after persistent commit.",
      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "ok",
        "result"
      ],
      "type": "object"
    },
    {
      "properties": {
        "error": {
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "type": "object"
        },
        "ok": {
          "const": false
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "type": "object"
    }
  ],
  "title": "DeskHub USB response"
}
